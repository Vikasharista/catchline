# LLM (via LiteLLM) — model name only, swappable without code changes.
# Primary is Claude; LLM_FALLBACK is a comma-separated list tried in order
# if the primary call fails (currently just gpt-4o-mini, cheap and fast).
LLM_MODEL=anthropic/claude-sonnet-4-5
LLM_FALLBACK=openai/gpt-4o-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Credit-wastage guardrails (app/llm.py, app/rate_limit.py):
# - LLM_DAILY_BUDGET_USD: once today's estimated spend (tracked from each
#   call's real token usage against an approximate price table in
#   app/llm.py) hits this, every further LLM call raises immediately
#   instead of going out — see GET /api/admin/llm-status to watch it.
# - LLM_CHAT_MAX_TOKENS: output cap per chat turn (co-pilot/analyst) —
#   much lower than extraction's 8192 default since a chat reply is
#   normally a sentence or two plus one proposal, not a structured doc.
# - LLM_CHAT_RATE_LIMIT_*: caps messages per RFQ within a rolling window,
#   independent of the budget — stops a burst (buggy loop, spam) before
#   it can even reach the model.
LLM_DAILY_BUDGET_USD=3.0
LLM_CHAT_MAX_TOKENS=1200
LLM_CHAT_RATE_LIMIT_COUNT=15
LLM_CHAT_RATE_LIMIT_WINDOW_S=600

# App
DATABASE_URL=sqlite:///./data/db.sqlite3
DATA_DIR=./data
LLM_CACHE_DIR=./data/cache

# Buyer site / defaults used only as chat suggestions, never silently applied
DEFAULT_INCOTERM_PLACE=Boulogne
