# LLM (via LiteLLM) — model name only, swappable without code changes.
# Primary and fallback are both OpenAI (gpt-4o, falling back to the
# cheaper/faster gpt-4o-mini on a transient failure) — LLM_FALLBACK still
# accepts a comma-separated list if you want a non-OpenAI provider back in
# the chain (previously Gemini/Groq; see git history), but this project
# currently runs on OpenAI only, one key.
LLM_MODEL=openai/gpt-4o
LLM_FALLBACK=openai/gpt-4o-mini
OPENAI_API_KEY=

# App
DATABASE_URL=sqlite:///./data/db.sqlite3
DATA_DIR=./data
LLM_CACHE_DIR=./data/cache

# Buyer site / defaults used only as chat suggestions, never silently applied
DEFAULT_INCOTERM_PLACE=Boulogne
