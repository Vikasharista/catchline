# LLM (via LiteLLM) — model name only, swappable without code changes.
# Primary stays Anthropic; LLM_FALLBACK is a comma-separated list tried in
# order if the primary call fails (e.g. Anthropic credit balance
# exhausted) — a second, independent fallback matters because a single
# fallback provider can itself have an outage (seen live: Gemini returning
# sustained 503 "high demand" with Anthropic already out of credit, which
# took the co-pilot down entirely until Groq was added here).
# gemini-flash-lite-latest, not gemini-3.6-flash: the 3.6 models are
# reasoning models that burn a large, variable share of the token budget
# on internal "thinking" before writing the JSON — bad for a
# deterministic, schema-constrained extraction task. flash-lite has no
# reasoning overhead (reasoning_tokens: None) and reproduced all 16 of
# S1's items correctly on a live test.
# groq/llama-3.3-70b-versatile: free tier, fast, and supports tool-calling
# (needed for the co-pilot's propose_change/ask tools) — get a free key at
# console.groq.com.
LLM_MODEL=anthropic/claude-sonnet-4-5
LLM_FALLBACK=gemini/gemini-flash-lite-latest,groq/llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# App
DATABASE_URL=sqlite:///./data/db.sqlite3
DATA_DIR=./data
LLM_CACHE_DIR=./data/cache

# Buyer site / defaults used only as chat suggestions, never silently applied
DEFAULT_INCOTERM_PLACE=Boulogne
